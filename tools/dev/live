#!/bin/sh
# Ist die Live-Seite schon auf dem Stand von origin/main? Vergleicht das Änderungsdatum der Wasm-Datei auf
# GitHub Pages mit dem letzten Commit auf main (die Veröffentlichung dauert etwa 3–15 Minuten).
cd "$(dirname "$0")/../.." || exit 1
git fetch -q origin main 2>/dev/null
lm=$(curl -sI -m 20 https://extro181.github.io/PirateGame/schwarzwasser_bg.wasm | tr -d '\r' | awk -F': ' 'tolower($1)=="last-modified"{print $2}')
[ -n "$lm" ] || { echo "live: Seite nicht erreichbar"; exit 1; }
ct=$(git log -1 --format=%ct origin/main)
lt=$(date -d "$lm" +%s 2>/dev/null || echo 0)
if [ "$lt" -ge "$ct" ]; then
  echo "live: aktuell (Stand $lm) · main: $(git log -1 --format='%h %s' origin/main | cut -c1-90)"
else
  echo "live: noch alt (Stand $lm) · main: $(git log -1 --format='%h %s' origin/main | cut -c1-90) – Veröffentlichung läuft noch oder hängt"
  exit 3
fi
